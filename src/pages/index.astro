---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getTopic, topics } from "../data/topics";

const articles = (await getCollection("articles", ({ data }) => !data.draft && !data.private)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const articleSlug = (id: string) => id.replace(/\.(md|mdx)$/, "");
const articleHref = (article: (typeof articles)[number]) =>
  `/${article.data.topic}/${articleSlug(article.id)}`;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(date);

const topicSummaries = topics.map((topic) => ({
  ...topic,
  articles: articles.filter((article) => article.data.topic === topic.slug),
}));

const featuredArticle = articles.find((article) => article.data.featured) ?? articles[0];
const recentArticles = articles.slice(0, 5);
const tagCloud = [
  ...new Set(articles.flatMap((article) => article.data.tags)),
].slice(0, 14);
---

<BaseLayout title="ServerDen">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Infrastructure / Kubernetes / Automation</p>
      <h1>ServerDen</h1>
      <p>
        Practical systems engineering tutorials, lab notes, and deployment
        walkthroughs for people building real infrastructure.
      </p>

      <div class="hero-actions">
        <a class="button" href="#topics">Browse topics</a>
        {featuredArticle && <a class="button secondary" href={articleHref(featuredArticle)}>Latest guide</a>}
      </div>
    </div>

    <aside class="signal-panel about-panel" aria-label="About Hristo Kovachev">
      <div class="panel-header">
        <span>about me</span>
        <span>serverden.local</span>
      </div>
      <h2>Hristo Kovachev</h2>
      <p>
        DevOps Engineer with a background in automation testing. Passionate
        homelabber and learner.
      </p>
      <div class="about-actions">
        <a class="button secondary" href="/about-me">About me</a>
        <a
          class="text-link"
          href="https://www.linkedin.com/in/hristo-kovachev-123124195/"
          rel="me noopener noreferrer"
          target="_blank"
        >
          LinkedIn
        </a>
      </div>
    </aside>
  </section>

  <section id="topics" class="section-block">
    <div class="section-heading">
      <p class="eyebrow">Topics</p>
      <h2>Choose what to read</h2>
    </div>

    <div class="topic-grid">
      {
        topicSummaries.map((topic) => (
          <a class="topic-card" href={`/${topic.slug}`} style={`--accent: ${topic.accent}`}>
            <span class="topic-count">{topic.articles.length} guide{topic.articles.length === 1 ? "" : "s"}</span>
            <h3>{topic.title}</h3>
            <p>{topic.description}</p>
            <div class="topic-tags">
              {topic.tags.slice(0, 3).map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="content-grid">
    <div class="article-list">
      <div class="section-heading compact">
        <p class="eyebrow">Latest</p>
        <h2>Field notes</h2>
      </div>

      {
        recentArticles.map((article) => {
          const topic = getTopic(article.data.topic);

          return (
            <a class="article-card" href={articleHref(article)}>
              <div>
                <span class="article-topic">{topic?.title ?? article.data.topic}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.description}</p>
              </div>
              <time datetime={article.data.pubDate.toISOString()}>{formatDate(article.data.pubDate)}</time>
            </a>
          );
        })
      }
    </div>

    <aside class="sidebar">
      <section>
        <h2>Recently Updated</h2>
        <div class="side-list">
          {
            recentArticles.map((article) => (
              <a href={articleHref(article)}>{article.data.title}</a>
            ))
          }
        </div>
      </section>

      <section>
        <h2>Tags</h2>
        <div class="tag-list">
          {tagCloud.map((tag) => <span>{tag}</span>)}
        </div>
      </section>
    </aside>
  </section>
</BaseLayout>
